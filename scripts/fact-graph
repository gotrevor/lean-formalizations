#!/usr/bin/env -S uv run --quiet python3
"""Render FACT-GRAPH.md: which named hypotheses imply which, and what rests on what.

Runs scripts/FactGraph.lean (a Lean metaprogram over the built environment, so the graph is read
from the kernel's statements, not parsed from source), then writes FACT-GRAPH.md at the repo root.
Exit 1 if a known edge is missing: that means the extractor went blind, not that math changed.

Usage: scripts/fact-graph            # regenerate FACT-GRAPH.md
       scripts/fact-graph --check    # only verify the known edges
"""
import collections, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# Status of each named hypothesis.  Anything not listed is a cited THEOREM.
CONJECTURES = {"SchanuelConjecture", "AlgIndepLogsConjecture", "FourExponentialsConjecture",
               "StrongFourExponentialsConjecture", "RoyConjecture", "RiemannHypothesis"}
# Known edges the extractor must see (hand-checked against the source, 2026-09-29).
MUST = {("SchanuelConjecture", "FourExponentialsConjecture"),
        ("SchanuelConjecture", "LindemannWeierstrassAlgIndep"),
        ("Ridout1958", "Roth1955")}


def extract():
    out = subprocess.run(["lake", "env", "lean", "scripts/FactGraph.lean"], cwd=ROOT,
                         capture_output=True, text=True, check=True).stdout
    rows = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) == 4 and parts[0] in {"edge", "refute", "uses", "plain"}:
            rows.append(parts)
    return rows


def main():
    rows = extract()
    edges = set()
    for kind, thm, hyps, concl in rows:
        if kind == "edge":
            for h in filter(None, hyps.split(",")):
                edges.add((h, concl))
    missing = MUST - edges
    if missing:
        print(f"extractor blind: missing known edges {sorted(missing)}", file=sys.stderr)
        sys.exit(1)
    if "--check" in sys.argv:
        print(f"ok: {len(edges)} edges")
        return
    uses = collections.defaultdict(list)
    for kind, thm, hyps, concl in rows:
        for h in filter(None, hyps.split(",")):
            uses[h].append(thm.removeprefix("LeanFormalizations."))
    refuted = sorted(c for k, _, _, c in rows if k == "refute")
    status = lambda p: "❌ refuted" if p in refuted else ("🔮 conjecture" if p in CONJECTURES else "📚 theorem")
    L = ["# Fact graph", "",
         "Generated by `scripts/fact-graph` from the built Lean environment (statements as the kernel",
         "sees them).  Do not edit by hand.  🔮 open conjecture · 📚 cited theorem · ❌ refuted in the kernel.", "",
         "## Implications between named hypotheses", "", "A theorem with several hypotheses draws one arrow from each (they are needed *jointly*).", "", "```mermaid", "graph LR"]
    ids = {}
    nid = lambda p: ids.setdefault(p, f"n{len(ids)}")
    for a, b in sorted(edges):
        L.append(f'  {nid(a)}["{a}"] --> {nid(b)}["{b}"]')
    L += ["```", "", "| Hypothesis | Status | Theorems resting on it |", "|---|---|---|"]
    for h in sorted(uses, key=lambda h: -len(uses[h])):
        L.append(f"| `{h}` | {status(h)} | {len(uses[h])} |")
    plain = sum(1 for k, *_ in rows if k == "plain")
    L += ["", f"Unconditional theorems in the scanned namespaces (no named hypothesis): {plain}.", ""]
    if refuted:
        L += ["## Refuted", ""] + [f"- `{r}`" for r in refuted] + [""]
    (ROOT / "FACT-GRAPH.md").write_text("\n".join(L), encoding="utf-8")
    print(f"wrote FACT-GRAPH.md: {len(edges)} edges, {len(uses)} hypotheses")


if __name__ == "__main__":
    main()
