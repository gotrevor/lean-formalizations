#!/usr/bin/env bash
# Green-gate: build before committing when staged changes touch Lean/lake files.
# In-repo bash hook (not the pre-commit framework) so it works offline / in the
# lean-yolo-box. Enable per clone: git config core.hooksPath .githooks
set -euo pipefail

if git diff --cached --name-only \
    | grep -qE '\.lean$|lakefile\.(toml|lean)$|lean-toolchain$|lake-manifest\.json$'; then
  if [ -f lakefile.toml ] || [ -f lakefile.lean ]; then
    echo "[pre-commit] lake build (green-gate) ..."
    lake build
  else
    echo "[pre-commit] no lakefile found; skipping build gate" >&2
  fi
fi
